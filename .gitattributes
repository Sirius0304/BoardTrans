# 统一换行符：Windows 批处理必须是 CRLF（否则 ^ 续行会失效），源码和文档用 LF
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.py text eol=lf
*.spec text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.ico binary
# 许可证文件：固定 LF，避免 Windows 检出时被改成 CRLF（其他平台阅读更规范）
LICENSE text eol=lf
